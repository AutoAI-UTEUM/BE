COMPOSE_PROJECT_NAME=edupilot
SPRING_PROFILES_ACTIVE=local

EDUPILOT_DB_NAME=edupilot
EDUPILOT_DB_USERNAME=edupilot
EDUPILOT_DB_PASSWORD=replace-with-local-db-password
EDUPILOT_DB_ROOT_PASSWORD=replace-with-local-root-password
EDUPILOT_DB_URL=jdbc:mysql://mysql:3306/edupilot?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC

EDUPILOT_CORS_ALLOWED_ORIGINS=http://localhost:5173
EDUPILOT_JWT_SECRET=replace-with-base64-encoded-secret-at-least-32-bytes
EDUPILOT_AI_BASE_URL=http://ai-service:8000
EDUPILOT_INTERNAL_TOKEN=replace-with-local-internal-token
EDUPILOT_STORAGE_DIR=/var/lib/edupilot/storage
EDUPILOT_UPLOAD_MAX_MB=45
EDUPILOT_AI_EXTRACT_READ_TIMEOUT=120s
EDUPILOT_AI_TURN_READ_TIMEOUT=180s
EDUPILOT_AI_GRADE_READ_TIMEOUT=90s
EDUPILOT_AI_PIPELINE_READ_TIMEOUT=45s
EDUPILOT_QUIZ_PASS_RATIO=0.6

AI_SERVICE_IMAGE=ghcr.io/autoai-edupilot/ai-service:pending
XAI_API_KEY=xai-example-not-a-real-key
MODEL_NAME=grok-4.5

TAG=latest
EDUPILOT_DOMAIN=example.com
