COMPOSE_PROJECT_NAME=edupilot
SPRING_PROFILES_ACTIVE=local

EDUPILOT_DB_NAME=edupilot
EDUPILOT_DB_USERNAME=edupilot
EDUPILOT_DB_PASSWORD=replace-with-local-db-password
EDUPILOT_DB_ROOT_PASSWORD=replace-with-local-root-password
EDUPILOT_DB_URL=jdbc:mysql://mysql:3306/edupilot?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC

EDUPILOT_CORS_ALLOWED_ORIGINS=http://localhost:5173
EDUPILOT_JWT_SECRET=replace-with-base64-encoded-secret-at-least-32-bytes
# Optional independent Base64 32-byte key. Empty derives a domain-separated key from JWT secret.
# Preserve across restarts; drain pending outbox before rotating this key or the fallback JWT secret.
EDUPILOT_MAIL_OUTBOX_ENCRYPTION_KEY=
# NORMAL preserves existing dispatch. PAUSED keeps new durable payloads without sending.
# ISOLATED_TRIAL requires one exact recipient and 1-3 reviewed delivery IDs; each can attempt once.
EDUPILOT_MAIL_OUTBOX_DISPATCH_MODE=NORMAL
EDUPILOT_MAIL_OUTBOX_DISPATCH_DELIVERY_IDS=
EDUPILOT_MAIL_OUTBOX_DISPATCH_RECIPIENT=
EDUPILOT_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
EDUPILOT_AI_BASE_URL=http://ai-service:8000
EDUPILOT_INTERNAL_TOKEN=replace-with-local-internal-token
EDUPILOT_AI_QUOTA_ENABLED=true
EDUPILOT_AI_QUOTA_DAILY_DEFAULT=200
EDUPILOT_AI_QUOTA_DAILY_INSTRUCTOR=500
EDUPILOT_ADMIN_INFRA_ENABLED=false
EDUPILOT_ADMIN_INFRA_REGION=ap-northeast-2
EDUPILOT_ADMIN_INFRA_INSTANCES_PROD=i-replace-with-prod-instance-id
EDUPILOT_ADMIN_INFRA_INSTANCES_DEV=i-replace-with-dev-instance-id
EDUPILOT_ADMIN_INFRA_METRICS_CACHE_TTL=5m
EDUPILOT_ADMIN_INFRA_COST_CACHE_TTL=12h
EDUPILOT_STORAGE_DIR=/var/lib/edupilot/storage
EDUPILOT_UPLOAD_MAX_MB=45
EDUPILOT_AI_EXTRACT_READ_TIMEOUT=200s
EXTRACT_TIMEOUT_SECONDS=120
EXTRACT_MAX_CONCURRENT=2
EXTRACT_MAX_WAITING=2
EXTRACT_QUEUE_TIMEOUT_SECONDS=10
EXTRACT_CLEANUP_TIMEOUT_SECONDS=5
EXTRACT_TOTAL_TIMEOUT_SECONDS=190
EDUPILOT_AI_XAI_FILE_UPLOAD_TIMEOUT=75s
EDUPILOT_XAI_FILE_BACKFILL_ENABLED=false
EDUPILOT_XAI_FILE_BACKFILL_BATCH=1
EDUPILOT_XAI_FILE_BACKFILL_RETRY_BACKOFF=PT6H
EDUPILOT_NOTIFICATION_EXAM_DEADLINE_ENABLED=true
EDUPILOT_AI_TURN_READ_TIMEOUT=200s
EDUPILOT_AI_STREAM_IDLE_TIMEOUT=30s
EDUPILOT_AI_GRADE_READ_TIMEOUT=90s
EDUPILOT_AI_PIPELINE_READ_TIMEOUT=45s
EDUPILOT_QUIZ_PASS_RATIO=0.6

AI_SERVICE_IMAGE=ghcr.io/autoai-uteum/ai-service:pending
XAI_API_KEY=xai-example-not-a-real-key
MODEL_NAME=grok-4.5
ORCHESTRATOR_REASONING_EFFORT=low
ORCHESTRATOR_MAX_TOKENS=16384
QA_REASONING_EFFORT=low
QA_MAX_TOKENS=16384
QUIZ_REASONING_EFFORT=medium
QUIZ_MAX_TOKENS=16384
NOTE_REASONING_EFFORT=medium

TAG=latest
EDUPILOT_DOMAIN=example.com
