{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteEduPilotDbBackups",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::uteum-db-backup/*"
    },
    {
      "Sid": "PublishEduPilotDbBackupFailure",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:ap-northeast-2:000000000000:REPLACE_WITH_EXISTING_ALARM_TOPIC"
    }
  ]
}
