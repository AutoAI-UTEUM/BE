{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendUteumTransactionalMailOnly",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "arn:aws:ses:ap-northeast-2:<AWS_ACCOUNT_ID>:identity/uteum.com",
      "Condition": {
        "StringEquals": {
          "ses:FromAddress": "no-reply@uteum.com"
        }
      }
    }
  ]
}
